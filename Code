<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management System | MCA Assignment</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="container">
        <header>
            <h1>Student Registration & Result Portal</h1>
            <p>Practical Assignment: HTML5, CSS3, & LocalStorage JSON Operations</p>
        </header>

        <main class="grid-container">
            <!-- LEFT SIDE: INPUT SECTION -->
            <section class="input-panel">
                <div class="card">
                    <h3>Student Registration Form</h3>
                    <form id="studentForm">
                        <div class="field">
                            <label>Full Name:</label>
                            <input type="text" id="name" placeholder="Enter name" required>
                        </div>
                        <div class="field">
                            <label>Roll Number:</label>
                            <input type="text" id="roll" placeholder="Enter roll no" required>
                        </div>
                        <div class="field">
                            <label>Web Technology Marks:</label>
                            <input type="number" id="marks1" min="0" max="100" required>
                        </div>
                        <div class="field">
                            <label>Database (DBMS) Marks:</label>
                            <input type="number" id="marks2" min="0" max="100" required>
                        </div>
                        <div class="field">
                            <label>Operating System Marks:</label>
                            <input type="number" id="marks3" min="0" max="100" required>
                        </div>
                        <button type="submit" class="btn-primary">Generate Result</button>
                    </form>
                </div>
            </section>

            <!-- RIGHT SIDE: IMMEDIATE OUTPUT SECTION -->
            <section class="output-panel">
                <div class="card" id="resultCard">
                    <h3>Last Calculated Result</h3>
                    <div id="liveOutput">
                        <p class="placeholder-text">Enter details and click 'Generate Result' to see the output here.</p>
                    </div>
                </div>
            </section>
        </main>

        <!-- BOTTOM: DATABASE RECORDS -->
        <section class="records-panel">
            <div class="card">
                <h3>All Registered Records (Stored in LocalStorage)</h3>
                <div class="table-container">
                    <table id="recordsTable">
                        <thead>
                            <tr>
                                <th>Roll No</th>
                                <th>Name</th>
                                <th>Total</th>
                                <th>%</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody"></tbody>
                    </table>
                </div>
                <button id="clearAll" class="btn-danger">Clear All Database</button>
                <footer style="margin-top: 30px; text-align: center; font-size: 0.8rem; color: #777; border-top: 1px solid #eee; padding-top: 10px;">
    Made by: Sahil Shirke | Roll No: 150097926011 | MCA Semester 1
</footer>
            </div>
        </section>
    </div>

    <script src="script.js"></script>
</body>
</html>
:root {
    --primary-color: #4a90e2;
    --success-color: #27ae60;
    --danger-color: #e74c3c;
    --bg-color: #f0f2f5;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--bg-color);
    margin: 0;
    padding: 20px;
}

.container {
    max-width: 1100px;
    margin: auto;
}

header {
    text-align: center;
    margin-bottom: 25px;
    color: #333;
}

/* Grid Layout for Input/Output */
.grid-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}

.card {
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}

h3 {
    margin-top: 0;
    border-bottom: 2px solid var(--primary-color);
    padding-bottom: 10px;
    color: var(--primary-color);
}

.field {
    margin-bottom: 12px;
}

label {
    display: block;
    margin-bottom: 5px;
    font-size: 0.9rem;
    font-weight: bold;
}

input {
    width: 100%;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 5px;
    box-sizing: border-box; /* Crucial for padding */
}

button {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    transition: 0.3s;
}

.btn-primary { background: var(--primary-color); color: white; margin-top: 10px; }
.btn-primary:hover { background: #357abd; }

.btn-danger { background: var(--danger-color); color: white; width: auto; margin-top: 15px; }

/* Result Display Styles */
#liveOutput {
    padding: 15px;
    background: #f9f9f9;
    border-radius: 5px;
}

.placeholder-text { color: #888; font-style: italic; }

.result-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 1.1rem;
}

/* Table Design */
.table-container { overflow-x: auto; }

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}

th, td {
    text-align: left;
    padding: 12px;
    border-bottom: 1px solid #eee;
}

th { background: #f8f9fa; }

.pass-badge { color: green; font-weight: bold; }
.fail-badge { color: red; font-weight: bold; }

/* Responsive Mobile Layout */
@media (max-width: 768px) {
    .grid-container { grid-template-columns: 1fr; }
}
// Student Registration & Result System - MCA Assignment Logic
document.addEventListener('DOMContentLoaded', () => {
    loadTableData(); // Display data from LocalStorage on page load
});

const studentForm = document.getElementById('studentForm');

studentForm.addEventListener('submit', (e) => {
    e.preventDefault();

    // 1. INPUT: Capture values from the UI
    const studentName = document.getElementById('name').value;
    const rollNo = document.getElementById('roll').value;
    const m1 = parseFloat(document.getElementById('marks1').value);
    const m2 = parseFloat(document.getElementById('marks2').value);
    const m3 = parseFloat(document.getElementById('marks3').value);

    // 2. PROCESSING: Logic & Calculations
    const total = m1 + m2 + m3;
    const percentage = ((total / 300) * 100).toFixed(2);
    const resultStatus = percentage >= 40 ? "Pass" : "Fail";

    // Create the Object
    const studentObj = {
        id: Date.now(), // Unique ID for each record
        name: studentName,
        roll: rollNo,
        total: total,
        per: percentage,
        status: resultStatus
    };

    // 3. OUTPUT: Show immediate result on the right-side card
    showLiveResult(studentObj);

    // 4. STORAGE: Save to LocalStorage (Converting Object to JSON)
    saveStudentToStorage(studentObj);

    // Reset form and refresh table
    studentForm.reset();
    loadTableData();
});

// Function to display the output immediately
function showLiveResult(obj) {
    const outputDiv = document.getElementById('liveOutput');
    const colorClass = obj.status === "Pass" ? "pass-badge" : "fail-badge";

    outputDiv.innerHTML = `
        <div class="result-item"><strong>Student:</strong> <span>${obj.name}</span></div>
        <div class="result-item"><strong>Total Marks:</strong> <span>${obj.total} / 300</span></div>
        <div class="result-item"><strong>Percentage:</strong> <span>${obj.per}%</span></div>
        <div class="result-item"><strong>Final Status:</strong> <span class="${colorClass}">${obj.status}</span></div>
    `;
}

// Storage Logic using JSON
function saveStudentToStorage(newStudent) {
    let students = JSON.parse(localStorage.getItem('mca_students')) || [];
    students.push(newStudent);
    localStorage.setItem('mca_students', JSON.stringify(students));
}

// Display Data in Table
function loadTableData() {
    const tableBody = document.getElementById('tableBody');
    const students = JSON.parse(localStorage.getItem('mca_students')) || [];
    
    tableBody.innerHTML = "";

    students.forEach(student => {
        const row = `
            <tr>
                <td>${student.roll}</td>
                <td>${student.name}</td>
                <td>${student.total}</td>
                <td>${student.per}%</td>
                <td class="${student.status.toLowerCase() === 'pass' ? 'pass-badge' : 'fail-badge'}">${student.status}</td>
                <td><button onclick="deleteRow(${student.id})" style="color:red; background:none; border:none; cursor:pointer;">Remove</button></td>
            </tr>
        `;
        tableBody.innerHTML += row;
    });
}

// Delete Record Logic
function deleteRow(id) {
    let students = JSON.parse(localStorage.getItem('mca_students'));
    students = students.filter(s => s.id !== id);
    localStorage.setItem('mca_students', JSON.stringify(students));
    loadTableData();
}

// Clear Entire Database
document.getElementById('clearAll').addEventListener('click', () => {
    if(confirm("Delete all records from LocalStorage?")) {
        localStorage.removeItem('mca_students');
        document.getElementById('liveOutput').innerHTML = '<p class="placeholder-text">Database Cleared.</p>';
        loadTableData();
    }
});
